{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openflow.example/schemas/screen.schema.json",
  "title": "Open Flow Screen",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "product", "platform", "name", "asset", "captured", "privacyReviewed", "submittedBy"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "product": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "platform": { "enum": ["ios", "android", "web", "desktop", "tablet", "watch", "tv", "other"] },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "asset": { "type": "string", "pattern": "^[^/]+\\.(png|jpg|jpeg|webp)$" },
    "captured": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$" },
    "region": { "type": "string", "minLength": 2, "maxLength": 80 },
    "productVersion": { "type": "string", "maxLength": 80 },
    "device": { "type": "string", "maxLength": 80 },
    "locale": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$" },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "privacyReviewed": { "const": true },
    "usesTestData": { "type": "boolean" },
    "submittedBy": { "type": "string", "pattern": "^@[A-Za-z0-9-]+$" },
    "notes": { "type": "string", "maxLength": 1000 }
  }
}

